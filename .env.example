# Supabase (fill in after creating your project)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional fallbacks (also configurable in Admin → API Keys vault)
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
PANDASCORE_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me-admin-password

# Android Go Live (APK or Play Store link shown when not in WebView)
NEXT_PUBLIC_ANDROID_APK_URL=
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=app.gameplaylive

# PC / OBS ingest (nginx-rtmp — see ingest-server/)
NEXT_PUBLIC_RTMP_INGEST_URL=rtmp://live.gameplaylive.com/app
NEXT_PUBLIC_HLS_PLAYBACK_BASE=https://live.gameplaylive.com/hls
INGEST_WEBHOOK_SECRET=change-me-ingest-webhook-secret

# Web Push (optional — generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@gameplaylive.app
