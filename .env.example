# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ---------------------------------------------------------------------------
# Google OAuth (paste Client ID + Secret into Supabase Auth → Google provider)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Platform admin Google email (auto role=admin)
ADMIN_EMAIL=gameplayliveapp@gmail.com

# ---------------------------------------------------------------------------
# Cashfree — Creator Pro ₹99/mo (server-only; never expose secrets to the browser)
# Create a monthly plan in Cashfree → copy plan_id into CASHFREE_PLAN_ID_INR
# Webhook URL: https://YOUR_DOMAIN/api/cashfree/webhook
# ---------------------------------------------------------------------------
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_PLAN_ID_INR=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENV=sandbox

# Optional Discord alerts for Creator Pro Go Live
DISCORD_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Optional AdSense client (ca-pub-…). Prefer Admin vault adsense_publisher_id
# Also powers /ads.txt and /app-ads.txt once set (pub- id derived automatically)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Optional API keys (also configurable in Admin → API Vault)
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
PANDASCORE_API_KEY=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me-admin-password

# Android Go Live
NEXT_PUBLIC_ANDROID_APK_URL=
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=app.gameplaylive

# PC / OBS ingest
NEXT_PUBLIC_RTMP_INGEST_URL=rtmp://live.gameplaylive.com/app
NEXT_PUBLIC_HLS_PLAYBACK_BASE=https://live.gameplaylive.com/hls
INGEST_WEBHOOK_SECRET=change-me-ingest-webhook-secret

# Web Push (optional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@gameplaylive.app
