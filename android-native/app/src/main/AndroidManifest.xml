<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <queries>
    <package android:name="com.pubg.imobile" />
    <package android:name="com.dts.freefiremax" />
    <package android:name="com.mojang.minecraftpe" />
    <package android:name="com.roblox.client" />
  </queries>

  <application
    android:allowBackup="false"
    android:label="Gameplay Live"
    android:supportsRtl="true"
    android:usesCleartextTraffic="false">

    <activity
      android:name=".MainActivity"
      android:exported="true"
      android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
      android:launchMode="singleTask">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="https" android:host="gameplaylive.app" />
      </intent-filter>
    </activity>

    <activity
      android:name=".StreamPermissionActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:theme="@android:style/Theme.Translucent.NoTitleBar" />

    <service
      android:name=".ScreenStreamService"
      android:exported="false"
      android:foregroundServiceType="mediaProjection" />
  </application>
</manifest>
